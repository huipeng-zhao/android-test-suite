<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:versionCode="6"
    android:versionName="6.0"
    package="com.android.ware.peripheral"
    android:sharedUserId="android.uid.system">
    <uses-sdk android:minSdkVersion="30" android:targetSdkVersion="30"/>
    <!-- Allows an application to bind PeripheralService.
     @hide
-->
    <permission android:name="com.android.ware.peripheral.permission.BIND"
        android:protectionLevel="system|signature" />

    <application
        android:name=".PeripheralApplication"
        android:label="@string/app_name"
        android:allowBackup="false"
        android:directBootAware="true"
        android:defaultToDeviceProtectedStorage="true">

        <service android:name=".PeripheralService"
            android:enabled="true"
            android:permission="com.android.ware.peripheral.permission.BIND">
        </service>
    </application>
</manifest>